# ============================================================
# BACKEND - VARIABLES D'ENVIRONNEMENT
# ============================================================

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://parkinvoice_user:parkinvoice_password@localhost:5432/parkinvoice_db

# --- Sécurité ---
SECRET_KEY=your-super-secret-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://parkinvoice-frontend.onrender.com

# --- Email ---
RESEND_API_KEY=re_your_api_key_here

# --- Upload ---
UPLOAD_DIR=./uploads

# --- Modèle ML ---
MODEL_PATH=./models_ia/parkinson_cnn+aug_off_weights_bst.h5
MODEL_KERAS_PATH=./models_ia/parkinson_model.keras

# --- Environnement ---
ENVIRONMENT=development
DEBUG=True
